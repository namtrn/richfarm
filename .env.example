# Convex
EXPO_PUBLIC_CONVEX_URL=https://your-convex-url.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-url.convex.site

# Local/dev-client E2E only. Never enable in production builds.
EXPO_PUBLIC_ENABLE_TEST_TRIGGERS=false

# RevenueCat public SDK keys. Use Test Store keys only for local/dev builds.
EXPO_PUBLIC_REVENUECAT_ENV=test
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY_TEST=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY_TEST=
# Production App Store / Google Play public SDK keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
